// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Layout Matriks:
            // SW00  SW01  SW02  SW03
            // SW10  SW11  SW12  SW13
            // SW20  SW21  SW22  SW23
            // SW30  SW31  SW32  SW33
            // EncSW
            bindings = <
                &kp KP_N7    &kp KP_N8    &kp KP_N9    &kp KP_PLUS
                &kp KP_N4    &kp KP_N5    &kp KP_N6    &kp KP_MINUS
                &kp KP_N1    &kp KP_N2    &kp KP_N3    &kp KP_ENTER
                &kp A        &kp KP_N0    &kp KP_DOT   &kp BSPC
                &kp C_MUTE
            >;

            // Pengaturan putaran encoder (CW: Vol Up, CCW: Vol Down)
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
