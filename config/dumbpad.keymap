#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &none  &kp NUM_7 &kp NUM_8 &kp NUM_9 &kp KP_PLUS
                &none  &kp NUM_4 &kp NUM_5 &kp NUM_6 &kp KP_MINUS
                &none  &kp NUM_1 &kp NUM_2 &kp NUM_3 &kp KP_MULTIPLY
                &kp NUM_0 &kp DOT  &kp ENTER &kp KP_DIVIDE &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
